{
  "name": "ucaba-language-support",
  "displayName": "UCABA",
  "description": "Soporte oficial para el lenguaje UCABA (.ucaba): coloreado de sintaxis, diagnósticos instantáneos con motor nativo v2.0 en Rust, autocompletado y consola interactiva REPL.",
  "version": "2.0.1",
  "author": "Facu Falcone <a.facundo.falcone@gmail.com>",
  "license": "GPL-3.0-or-later",
  "icon": "icon.png",
  "publisher": "ucaba",
  "repository": {
    "type": "git",
    "url": "https://github.com/caidevOficial/UCABA_Lang"
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:ucaba",
    "workspaceContains:**/*.ucaba",
    "onStartupFinished",
    "onDebugResolve:ucaba"
  ],
  "contributes": {
    "iconThemes": [
      {
        "id": "ucaba-icons",
        "label": "UCABA",
        "path": "./icons/ucaba-icon-theme.json"
      }
    ],
    "languages": [
      {
        "id": "ucaba",
        "aliases": [
          "UCABA",
          "ucaba"
        ],
        "extensions": [
          ".ucaba"
        ],
        "filenamePatterns": [
          "*.ucaba",
          "**/*.ucaba"
        ],
        "mimetypes": [
          "application/x-ucaba",
          "text/x-ucaba"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/ucaba-file.svg",
          "dark": "./icons/ucaba-file.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "ucaba",
        "scopeName": "source.ucaba",
        "path": "./syntaxes/ucaba.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "ucaba",
        "path": "./snippets/snippets.json"
      }
    ],
    "breakpoints": [
      {
        "language": "ucaba"
      }
    ],
    "debuggers": [
      {
        "type": "ucaba",
        "label": "UCABA",
        "languages": [
          "ucaba"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Ruta del archivo .ucaba a depurar.",
                "default": "${file}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Detener en la primera sentencia ejecutable.",
                "default": false
              },
              "lenient": {
                "type": "boolean",
                "description": "Modo permisivo para pseudocódigo informal.",
                "default": false
              },
              "cwd": {
                "type": "string",
                "description": "Directorio de trabajo (para rutas relativas de ARCHIVO).",
                "default": "${workspaceFolder}"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "ucaba",
            "request": "launch",
            "name": "UCABA: Depurar archivo actual",
            "program": "${file}",
            "stopOnEntry": false
          }
        ],
        "configurationSnippets": [
          {
            "label": "UCABA: Depurar archivo",
            "description": "Configuración para depurar un archivo .ucaba",
            "body": {
              "type": "ucaba",
              "request": "launch",
              "name": "UCABA: Depurar archivo actual",
              "program": "${file}",
              "stopOnEntry": false
            }
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "ucaba.runFile",
        "title": "UCABA: Ejecutar archivo actual",
        "category": "UCABA"
      },
      {
        "command": "ucaba.checkFile",
        "title": "UCABA: Verificar sintaxis y tipos del archivo",
        "category": "UCABA"
      },
      {
        "command": "ucaba.debugFile",
        "title": "UCABA: Depurar archivo actual",
        "category": "UCABA",
        "icon": "$(debug-alt)"
      },
      {
        "command": "ucaba.startRepl",
        "title": "UCABA: Iniciar consola interactiva REPL",
        "category": "UCABA"
      },
      {
        "command": "ucaba.activateIcons",
        "title": "UCABA: Activar tema de iconos oficial de UCABA",
        "category": "UCABA"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "ucaba.runFile",
          "when": "resourceExtname == .ucaba",
          "group": "navigation@1"
        },
        {
          "command": "ucaba.debugFile",
          "when": "resourceExtname == .ucaba",
          "group": "navigation@2"
        },
        {
          "command": "ucaba.startRepl",
          "when": "resourceExtname == .ucaba",
          "group": "navigation@3"
        }
      ],
      "editor/context": [
        {
          "command": "ucaba.runFile",
          "when": "resourceExtname == .ucaba",
          "group": "1_modification@1"
        },
        {
          "command": "ucaba.checkFile",
          "when": "resourceExtname == .ucaba",
          "group": "1_modification@2"
        },
        {
          "command": "ucaba.startRepl",
          "when": "resourceExtname == .ucaba",
          "group": "1_modification@3"
        }
      ]
    },
    "configuration": {
      "title": "UCABA Pseudocode",
      "properties": {
        "ucaba.cliPath": {
          "type": "string",
          "default": "",
          "description": "Ruta al ejecutable 'ucaba.exe' (detectado automáticamente si está instalado)."
        },
        "ucaba.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Ruta al ejecutable de Python (por defecto usa 'python' en PATH o el intérprete configurado)."
        }
      }
    }
  }
}
